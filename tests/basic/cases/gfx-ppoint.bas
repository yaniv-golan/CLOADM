# bb-only: reading points back (docs/clean-room-basic-p2.md sections 3 and 5). Known bytes are POKEd into the start
# of page 1 ($0600: 27, 165; the next row's first byte 228) and PPOINT reads every pixel of them in each mode and
# colour set; then each colour 0-8 is PSET and read back with PPOINT. Last, SET, RESET and POINT on the text screen
# (semigraphics points, a text character's cell), with a picture. The POKEs stay in the cold-start pages (no PCLEAR).
# Syntax [UM]; the values printed and the picture [BB].
20 POKE 1536,27:POKE 1537,165:POKE 1552,228:POKE 1568,228
30 RETURN
100 GOSUB 20:PMODE 3,1:SCREEN 1,0:PRINT "PMODE 3,0"
110 FOR X=0 TO 15:PRINT PPOINT(X AND 255,0);:NEXT:PRINT:FOR X=0 TO 7:PRINT PPOINT(X AND 255,1);:NEXT:PRINT
120 SCREEN 1,1:PRINT "PMODE 3,1"
130 FOR X=0 TO 15:PRINT PPOINT(X AND 255,0);:NEXT:PRINT
140 PMODE 1,1:SCREEN 1,0:PRINT "PMODE 1"
150 FOR X=0 TO 15:PRINT PPOINT(X AND 255,0);:NEXT:PRINT:FOR Y=0 TO 3:PRINT PPOINT(0,Y AND 255);:NEXT:PRINT
160 PMODE 4,1:SCREEN 1,0:PRINT "PMODE 4,0"
170 FOR X=0 TO 15:PRINT PPOINT(X AND 255,0);:NEXT:PRINT
180 SCREEN 1,1:PRINT "PMODE 4,1"
190 FOR X=0 TO 15:PRINT PPOINT(X AND 255,0);:NEXT:PRINT
200 PMODE 0,1:SCREEN 1,0:PRINT "PMODE 0"
210 FOR X=0 TO 31 STEP 2:PRINT PPOINT(X AND 255,0);:NEXT:PRINT:FOR Y=0 TO 3:PRINT PPOINT(0,Y AND 255);:NEXT:PRINT
220 PMODE 2,1:SCREEN 1,0:PRINT "PMODE 2"
230 FOR Y=0 TO 3:PRINT PPOINT(0,Y AND 255);:NEXT:PRINT
240 END
300 PMODE 3,1:SCREEN 1,0:PCLS:PRINT "PSET 0-8 IN PMODE 3,0"
310 FOR C=0 TO 8:PSET(C*4 AND 255,20,C):PRINT PPOINT(C*4 AND 255,20);:NEXT:PRINT
320 SCREEN 1,1:PCLS:PRINT "PSET 0-8 IN PMODE 3,1"
330 FOR C=0 TO 8:PSET(C*4 AND 255,20,C):PRINT PPOINT(C*4 AND 255,20);:NEXT:PRINT
340 PMODE 4,1:SCREEN 1,0:PCLS:PRINT "PSET 0-8 IN PMODE 4,0"
350 FOR C=0 TO 8:PSET(C*4 AND 255,20,C):PRINT PPOINT(C*4 AND 255,20);:NEXT:PRINT
360 SCREEN 1,1:PCLS:PRINT "PSET 0-8 IN PMODE 4,1"
370 FOR C=0 TO 8:PSET(C*4 AND 255,20,C):PRINT PPOINT(C*4 AND 255,20);:NEXT:PRINT
380 PRESET(4,20):PRINT PPOINT(4,20)
390 END
500 FOR I=1 TO 15:PRINT:NEXT:PRINT "AB";
510 SET(0,0,3):SET(1,0,4):SET(2,1,5):SET(63,31,2):SET(10,10,8):SET(11,10,1):SET(10,11,0)
520 RESET(11,10):SET(2,30,3)
530 FOR I=0 TO 3:P(I)=POINT(I AND 63,0):NEXT:P(4)=POINT(2,1):P(5)=POINT(63,31):P(6)=POINT(10,10):P(7)=POINT(11,10)
540 P(8)=POINT(10,11):P(9)=POINT(0,30):P(10)=POINT(3,30)
590 POKE 1534,81:POKE 1535,113
599 GOTO 599
RUN 100
RUN 300
#nowait
RUN 500
