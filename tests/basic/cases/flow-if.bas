# IF THEN ELSE, GOTO, GOSUB, ON [UM]
10 FOR I=1 TO 4
20 IF I=1 THEN PRINT "ONE" ELSE IF I=2 THEN PRINT "TWO" ELSE PRINT "MORE";I
30 NEXT
40 IF 0 THEN 100
50 IF 1 THEN 60
55 PRINT "SKIPPED"
60 ON 2 GOTO 70,80
70 PRINT "SEVENTY"
80 PRINT "EIGHTY"
90 ON 3 GOSUB 200,300:ON 1 GOSUB 200:PRINT "AFTER"
95 IF 1 GOSUB 300
96 IF 1 GOTO 999
100 PRINT "HUNDRED"
200 PRINT "SUB200":RETURN
300 PRINT "SUB300":RETURN
999 IF "A" THEN 1
RUN
GOTO 1000
RETURN
