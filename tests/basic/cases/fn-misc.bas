# PEEK and POKE in RAM, DEF FN, VARPTR, MEM, POS, TIMER, RND's ranges [UM]
POKE 20000,123:PRINT PEEK(20000)
POKE 20000,256
10 DEF FN SQ(X)=X*X
20 DEF FN H(X)=FN SQ(X)+X
30 X=5:PRINT FN SQ(3);FN H(2);X
40 DEF FN A$(X)=STRING$(X,"*")
50 PRINT FN A$(3)
RUN
PRINT FN SQ(4)
PRINT FN Q(1)
DEF FN Z(X)=X
A=1:PRINT VARPTR(A)>7680;VARPTR(A)<32768
PRINT MEM>20000;MEM<32768
PRINT "ABC";POS(0)
TIMER=100:PRINT TIMER>=100
NEW
10 FOR I=1 TO 200:R=RND(6):IF R<1 OR R>6 OR R<>INT(R) THEN PRINT "BAD";R
20 F=RND(0):IF F<0 OR F>=1 THEN PRINT "BAD";F
30 NEXT:PRINT "RANGES OK"
RUN
