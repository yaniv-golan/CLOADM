# FOR, NEXT, STEP, nesting; NEXT without FOR [UM]
FOR I=1 TO 3:PRINT I;:NEXT:PRINT
FOR I=5 TO 1 STEP -2:PRINT I;:NEXT I:PRINT
FOR I=0 TO 1 STEP .25:PRINT I;:NEXT:PRINT
FOR I=1 TO 2:FOR J=1 TO 2:PRINT I*10+J;:NEXT J,I:PRINT
FOR I=1 TO 0:PRINT "ONCE";I:NEXT:PRINT I
FOR I=1 TO 3:NEXT:PRINT I
NEXT
10 FOR K=1 TO 3
20 PRINT "K";K
30 NEXT K
40 PRINT "DONE";K
RUN
