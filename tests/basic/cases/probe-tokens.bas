# bb-only: the token probe (docs/clean-room-basic.md section 7). Lines 2000 and up hold one keyword each,
# after END: (a function after X=), and are never run; the program finds them in RAM after the REM ZQZQ marker and
# prints, for each, its line number, its bytes in hex, and whether its link points at the next line.
# No ROM is read: every PEEK is kept below 32768 by AND 32767 (tools/basic-bb/lint.js).
#timeout 600
10 A=0:FOR I=1536 TO 32700
20 IF PEEK(I AND 32767)=90 AND PEEK(I+1 AND 32767)=81 AND PEEK(I+2 AND 32767)=90 AND PEEK(I+3 AND 32767)=81 THEN IF PEEK(I+4 AND 32767)=0 AND PEEK(I+7 AND 32767)=7 AND PEEK(I+8 AND 32767)=208 THEN A=I:I=32700
30 NEXT I
40 IF A=0 THEN PRINT "NOT FOUND":END
50 PRINT "MARKER AT";A:P=A+5
60 L=PEEK(P AND 32767)*256+PEEK(P+1 AND 32767):IF L=0 THEN PRINT "END AT";P:END
70 PRINT PEEK(P+2 AND 32767)*256+PEEK(P+3 AND 32767);:Q=P+4
80 B=PEEK(Q AND 32767):Q=Q+1:IF B THEN PRINT HEX$(B);" ";:GOTO 80
90 IF L=Q THEN PRINT "LINK OK" ELSE PRINT "LINK";L
100 P=L:GOTO 60
1000 END
