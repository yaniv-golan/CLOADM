# bb-only: SIN, COS and TAN of large arguments (docs/clean-room-basic.md section 5): ours gives ?FC ERROR from some
# size on. 1E5 as a control, then plus and minus 1000000, 1E9, 1E10, 1E20 and 1E38: the value, or the error. One
# line each, so an error stops only its own line. Syntax [UM]; the answers [BB].
PRINT SIN(1E5);COS(1E5);TAN(1E5)
PRINT SIN(1000000)
PRINT SIN(-1000000)
PRINT SIN(1E9)
PRINT SIN(-1E9)
PRINT SIN(1E10)
PRINT SIN(1E20)
PRINT SIN(-1E20)
PRINT SIN(1E38)
PRINT COS(1000000)
PRINT COS(-1000000)
PRINT COS(1E9)
PRINT COS(-1E9)
PRINT COS(1E10)
PRINT COS(1E20)
PRINT COS(-1E20)
PRINT COS(1E38)
PRINT TAN(1000000)
PRINT TAN(-1000000)
PRINT TAN(1E9)
PRINT TAN(-1E9)
PRINT TAN(1E10)
PRINT TAN(1E20)
PRINT TAN(-1E20)
PRINT TAN(1E38)
