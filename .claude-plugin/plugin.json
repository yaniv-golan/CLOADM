{
  "name": "cloadm",
  "displayName": "CLOADM",
  "version": "0.4.2",
  "description": "Play Dragon and Tandy Color Computer machines with Claude: live in Claude's side panel, or on your computer with your own ROMs and files.",
  "author": {
    "name": "Yaniv Golan",
    "url": "https://github.com/yaniv-golan"
  },
  "homepage": "https://github.com/yaniv-golan/CLOADM/blob/main/docs/mcp.md",
  "repository": "https://github.com/yaniv-golan/CLOADM",
  "license": "MIT",
  "keywords": [
    "emulator",
    "dragon",
    "coco",
    "trs-80",
    "6809",
    "retro",
    "mcp"
  ],
  "icon": "./icons/icon-512.png",
  "mcpServers": {
    "CLOADM on this computer": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/cli/cloadm.js",
        "--mcp",
        "--no-skills"
      ]
    },
    "CLOADM side panel": {
      "type": "http",
      "url": "https://mcp.cloadm.dev/mcp"
    }
  },
  "network": {
    "hosts": [
      "mcp.cloadm.dev"
    ]
  }
}
