{
  "name": "cloadm-both",
  "version": "0.1.8-pre",
  "description": "TEST plugin (branch claude/plugin-both-servers-test, never for main): the CLOADM skill, the local MCP server (cloadm-files: your ROMs and ~/CLOADM) and the remote side-panel connector (cloadm-panel: https://mcp.cloadm.dev/mcp) in one plugin.",
  "author": {
    "name": "Yaniv Golan",
    "url": "https://github.com/yaniv-golan"
  },
  "homepage": "https://github.com/yaniv-golan/CLOADM/blob/main/docs/mcp.md",
  "repository": "https://github.com/yaniv-golan/CLOADM",
  "license": "MIT",
  "keywords": [
    "emulator",
    "dragon",
    "coco",
    "trs-80",
    "6809",
    "retro",
    "mcp"
  ],
  "icon": "./icons/icon-512.png",
  "mcpServers": {
    "cloadm-files": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/cli/cloadm.js",
        "--mcp"
      ]
    },
    "cloadm-panel": {
      "type": "http",
      "url": "https://mcp.cloadm.dev/mcp"
    }
  },
  "network": {
    "hosts": [
      "mcp.cloadm.dev"
    ]
  }
}
